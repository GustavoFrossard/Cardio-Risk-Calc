@startuml CardioRisk_Arquitetura
title Arquitetura — CardioRisk Periop

skinparam backgroundColor #F7F8FA
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12

skinparam component {
  BorderColor       #1A6BF0
  BackgroundColor   #EBF1FE
  FontColor         #0D1117
}

skinparam database {
  BorderColor       #C47A00
  BackgroundColor   #FFF8E6
}

skinparam ArrowColor  #555555
skinparam ArrowFontSize 11

package "Vercel" as vercel {
  [Frontend Web\n(React + Vite)]           as frontend  #EBF1FE
  database "LocalStorage\n(navegador)"     as ls        #FFF8E6
}

package "Render (nuvem)" as render {
  [Backend API\n(FastAPI)]                 as api       #EDFAF4
  [Analisador de Texto Clínico\n(regras + NER)] as nlp  #EDFAF4
  [Motor de Cálculo\n(RCRI / VSG)]         as calc      #EDFAF4
}

frontend  --> api      : HTTP REST\n(/calculate, /nlp/analyze)
frontend  --> ls       : salva sessão
api       ..> nlp      : texto clínico livre\n(opcional)
nlp       --> calc     : variáveis extraídas\n(revisadas pelo médico)
api       --> calc     : dados do formulário

@enduml
