@startuml CardioRisk_CasosDeUso
title Casos de Uso — CardioRisk Periop

skinparam backgroundColor #F7F8FA
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12

skinparam actor {
  BorderColor #1A6BF0
  FontColor   #1A6BF0
  FontStyle   bold
}

skinparam usecase {
  BorderColor       #1A6BF0
  BackgroundColor   #EBF1FE
  FontSize          12
}

skinparam ArrowColor  #555555

actor "Médico" as medico

rectangle "Sistema CardioRisk Periop" {
  usecase "Preencher dados do paciente"                  as UC1
  usecase "Auto-preencher via texto clínico"              as UC2
  usecase "Identificar cirurgia e risco do procedimento"  as UC3
  usecase "Preencher critérios de risco\n(RCRI ou VSG)"   as UC4
  usecase "Calcular risco cardiovascular"                 as UC5
  usecase "Ver resultado e recomendações"                 as UC6
  usecase "Baixar PDF / Compartilhar resultado"           as UC7
  usecase "Alternar tema claro/escuro"                    as UC8
}

medico --> UC1
medico --> UC2
medico --> UC3
medico --> UC4
medico --> UC5
medico --> UC6
medico --> UC7
medico --> UC8

@enduml
