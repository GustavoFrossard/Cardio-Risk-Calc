@startuml CardioRisk_Classes
title Classes principais — CardioRisk Periop

skinparam backgroundColor #F7F8FA
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0

skinparam class {
  BorderColor       #1A6BF0
  BackgroundColor   #FFFFFF
  HeaderBackgroundColor #1A6BF0
  FontColor         #0D1117
  AttributeFontColor #3D4451
  StereotypeFontColor #EBF1FE
}

skinparam ArrowColor  #555555
skinparam ArrowFontSize 11

package "Backend · Python" #EBF1FE {
  class DadosPaciente <<Pydantic Model>> {
    idade, comorbidades, medicamentos,
    cirurgia, critérios RCRI / VSG,
    condições cardiovasculares ativas
  }

  class API <<main.py>> {
    + raiz(), saude()
    + calcular(paciente)
    + analisar_caso_clinico(texto)
  }

  class Calculator <<core/calculator.py>> {
    + calcular_risco(data) : dict
    ' RCRI/VSG, recomendações, exames,
    ' orientações de medicação
  }

  class ClinicalNLP <<core/clinical_nlp.py>> {
    + analisar_texto_clinico(texto) : dict
    ' regras + NER local opcional
  }
}

package "Frontend · React" #EDFAF4 {
  class useAssistente <<hooks/useWizard.js>> {
    + avancar(), voltar()
    + analisarTextoClinico(texto)
  }

  class ServicoApi <<services/api.js>> {
    + calcularRisco(dados)
    + analisarCasoClinico(texto)
  }
}

API          -->  Calculator     : chama
API          -->  ClinicalNLP    : chama
API          ..>  DadosPaciente  : <<use>>
useAssistente -->  ServicoApi     : chama
ServicoApi   ..>  API            : HTTP REST

@enduml
