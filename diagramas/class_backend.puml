@startuml CardioRisk_Classes
title Diagrama de Classes — CardioRisk Periop

skinparam backgroundColor   #F7F8FA
skinparam defaultFontName   Segoe UI
skinparam defaultFontSize   11
skinparam classAttributeIconSize 0

skinparam class {
  BorderColor       #1A6BF0
  BackgroundColor   #FFFFFF
  HeaderBackgroundColor #1A6BF0
  FontColor         #0D1117
  AttributeFontColor #3D4451
  StereotypeFontColor #EBF1FE
}

skinparam enum {
  BorderColor       #5B94F5
  BackgroundColor   #EBF1FE
  HeaderBackgroundColor #5B94F5
}

skinparam ArrowColor  #555555
skinparam ArrowFontSize 10

' ═══════════════════════════════════════════════════════════════════
' BACKEND — Python / FastAPI
' ═══════════════════════════════════════════════════════════════════

package "Backend · Python" #EBF1FE {

  ' ── Modelos Pydantic ─────────────────────────────────────────────
  class DadosPaciente <<Pydantic BaseModel>> {
    ' Identificação
    + nome : Optional[str]
    + idade  : Optional[int]
    ' Comorbidades
    + obesidade                : bool
    + ic_conhecida             : bool
    + doenca_valvar_conhecida  : bool
    + dac_conhecida            : bool
    + eco_recente              : bool
    + piora_sintomas           : bool
    ' Medicamentos
    + usa_aas                  : bool
    + prevencao_aas            : str
    + usa_clopidogrel          : bool
    + usa_ticagrelor           : bool
    + usa_prasugrel            : bool
    + usa_varfarina            : bool
    + indicacao_varfarina      : str
    + chadsvasc_varfarina      : Optional[int]
    + avc_3m_varfarina         : bool
    + tempo_tev_varfarina      : str
    + trombofilia_varfarina    : str
    + neoplasia_ativa_varfarina : bool
    ' Capacidade funcional
    + atividades_funcionais    : list[str]
    + mets                     : float
    ' Cirurgia
    + tipo_cirurgia   : str
    + risco_cirurgia  : str
    + eh_vascular     : bool
    ' Condições CV ativas (cv_* × 11)
    + cv_coronaria_aguda           : bool
    + cv_aorta_instavel            : bool
    + cv_edema_pulmonar_agudo      : bool
    + cv_choque_cardiogenico       : bool
    + cv_ic_nyha_3_4               : bool
    + cv_angina_ccs_3_4            : bool
    + cv_arritmia_grave            : bool
    + cv_has_nao_controlada        : bool
    + cv_fa_alta_resposta          : bool
    + cv_hap_sintomatica           : bool
    + cv_valvopatia_grave          : bool
    ' Critérios RCRI (rcri_* × 6)
    + rcri_cirurgia_alto_risco  : bool
    + rcri_doenca_coronaria     : bool
    + rcri_ic                   : bool
    + rcri_cerebrovascular      : bool
    + rcri_diabetes_insulina    : bool
    + rcri_creatinina_acima_2   : bool
    ' Critérios VSG (vsg_* × 9)
    + vsg_faixa_etaria          : str
    + vsg_dac                   : bool
    + vsg_ic                    : bool
    + vsg_dpoc                  : bool
    + vsg_creatinina_acima_1_8  : bool
    + vsg_tabagismo             : bool
    + vsg_diabetes_insulina     : bool
    + vsg_betabloqueador_cronico : bool
    + vsg_revasc_previa         : bool
  }

  class RequisicaoTextoClinico <<Pydantic BaseModel>> {
    + text         : str
    + current_data : dict[str, Any]
  }

  ' ── Enumerações ──────────────────────────────────────────────────
  enum RiscoCirurgia {
    BAIXO
    INTERMEDIARIO
    ALTO
  }

  enum ClasseRisco {
    BAIXO
    INTERMEDIARIO
    ALTO
  }

  enum TipoRecomendacao {
    VERDE
    AMARELO
    VERMELHO
  }

  ' ── API FastAPI ───────────────────────────────────────────────────
  class API <<FastAPI · main.py>> {
    --
    + GET  /              raiz()                : dict
    + GET  /health        saude()                : dict
    + POST /calculate     calcular()             : dict
    + POST /nlp/analyze   analisar_caso_clinico() : dict
    --
    - _origens_cors_do_ambiente() : list[str]
  }

  ' ── Calculadora ──────────────────────────────────────────────────
  class Calculator <<core/calculator.py>> {
    + calcular_risco(data: dict) : dict
    + pontuar_rcri(data: dict) : tuple[int, list[str]]
    + pontuar_vsg(data: dict)  : tuple[int, list[str]]
    + verificar_condicoes_ativas(data: dict) : list[str]
    + montar_recomendacoes(...) : list[dict]
    + montar_orientacoes_medicacao(data: dict) : list[dict]
    ' cada item: {medicamento, acao, detalhe, tipo, dias_antes}
    + montar_recomendacoes_exames(data, classe_risco, pontuacao) : list[str]
    + montar_fatores_risco(data, criterios_atingidos, mets) : list[str]
    - _obter_classe_risco_rcri(pontuacao: int) : tuple[str, str]
    - _obter_classe_risco_vsg(pontuacao: int)  : tuple[str, str]
    - _determinar_ponte_varfarina(data: dict) : dict
  }

  ' ── NLP ──────────────────────────────────────────────────────────
  class ClinicalNLP <<core/clinical_nlp.py>> {
    + analisar_texto_clinico(
        text: str,
        current_data: dict
      ) : dict
    ' Retorna: autofill, missing_critical, findings,
    ' entities, model, summary, context
    - _extrair_idade(text) : int | None
    - _extrair_nome(text) : str | None
    - _extrair_cirurgia(texto_normalizado) : dict | None
    - _extrair_mets(text) : float | None
    - _extrair_creatinina(text) : float | None
    - _extrair_egfr(text) : float | None
    - _obter_pipeline_ner() : pipeline | None
    ' NER local opcional (pucpr/clinicalnerpt-medical);
    ' sem dependência de LLM externo
  }

}

' ═══════════════════════════════════════════════════════════════════
' FRONTEND — React / JavaScript
' ═══════════════════════════════════════════════════════════════════

package "Frontend · React" #EDFAF4 {

  class ServicoApi <<src/services/api.js>> {
    - baseUrl : string
    --
    + calcularRisco(dados: object)        : Promise<dict>
    + analisarCasoClinico(
        text: string,
        currentData: object
      )                                   : Promise<dict>
    + verificarSaude()                    : Promise<dict>
  }

  class ErroApi <<extends Error>> {
    + status  : number
    + name    : string
    + message : string
  }

  class useAssistente <<src/hooks/useWizard.js>> {
    - etapaAtual    : number
    - maiorEtapa    : number
    - dadosFormulario : DadosPaciente
    - resultado     : dict | null
    - carregando    : boolean
    - analisando    : boolean
    - temDadosSalvos : boolean
    - resultadoNlp  : dict | null
    --
    + avancar()                      : void
    + voltar()                       : void
    + irParaEtapa(etapa: number)     : void
    + atualizarCampo(key, value)     : void
    + retomar()                      : void
    + reiniciar()                    : void
    + analisarTextoClinico(text)     : Promise<void>
    - carregarSalvo()                : dict | null
    - salvarNoDisco(etapa, dados)    : void
  }

  class useTheme <<src/hooks/useTheme.js>> {
    - theme : "light" | "dark"
    --
    + toggle() : void
    - obterTemaDoSistema() : string
    - obterTemaInicial()   : string
  }

  class ReportService <<src/services/report.js>> {
    + gerarRelatorio(
        resultado : dict,
        dados     : object
      ) : void
    - obterRotuloCirurgia(tipoCirurgia) : string
    - adicionarPagina(doc, y, needed)   : number
    - estaRodandoNoWebViewReactNative() : boolean
  }

  class ResumoUtils <<src/utils/resumo.js>> {
    + resumirPaciente(dados)      : {idade, mets}
    + resumirCirurgia(dados)      : {definida, rotulo, risco}
    + resumirComorbidades(dados)  : string[]
    + resumirMedicamentos(dados)  : string[]
  }

}

' ═══════════════════════════════════════════════════════════════════
' RELACIONAMENTOS
' ═══════════════════════════════════════════════════════════════════

' Backend interno
API          ..>  DadosPaciente          : <<use>>
API          ..>  RequisicaoTextoClinico  : <<use>>
API          -->  Calculator              : chama
API          -->  ClinicalNLP             : chama

Calculator   ..>  RiscoCirurgia          : <<use>>
Calculator   ..>  ClasseRisco            : <<use>>
Calculator   ..>  TipoRecomendacao       : <<use>>

' Frontend interno
useAssistente -->  ServicoApi             : chama
useAssistente ..>  ReportService          : <<use>>
ServicoApi    ..>  ErroApi               : <<throws>>
ResumoUtils   ..>  DadosPaciente         : <<lê campos de>>

' Frontend → Backend (HTTP REST)
ServicoApi   ..>  API                    : HTTP REST\nPOST /calculate\nPOST /nlp/analyze

@enduml
